generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  iconName  String?
  campaigns Campaign[]
  createdAt DateTime   @default(now())
}

model Campaign {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  targetAmount    Float
  collectedAmount Float            @default(0)
  donorCount      Int              @default(0)
  endDate         DateTime
  isUrgent        Boolean          @default(false)
  isFeatured      Boolean          @default(false)
  location        String?
  excerpt         String?
  story           String
  bannerUrl       String?
  status          String           @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  updates         CampaignUpdate[]
  donations       Donation[]

  @@index([categoryId])
  @@index([isUrgent])
  @@index([isFeatured])
  @@index([status])
}

model CampaignUpdate {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title           String
  content         String
  disbursedAmount Float    @default(0)
  date            DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([campaignId])
}

model Donation {
  id             String    @id @default(cuid())
  invoiceId      String    @unique
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id])
  donationType   String    @default("CAMPAIGN") // CAMPAIGN, ZAKAT, INFAK_SUBUH, WAKAF
  amount         Float
  uniqueCode     Int       @default(0)
  totalAmount    Float
  paymentChannel String // QRIS, BCA_VA, MANDIRI_VA, BSI_VA, BRI_VA
  paymentRef     String?
  donorName      String
  donorEmail     String?
  donorPhone     String
  isAnonymous    Boolean   @default(false)
  prayer         String?
  status         String    @default("PENDING") // PENDING, PAID, EXPIRED, CANCELLED
  paidAt         DateTime?
  expiredAt      DateTime
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  @@index([invoiceId])
  @@index([campaignId])
  @@index([status])
}

model AuditReport {
  id               String   @id @default(cuid())
  year             Int
  title            String
  auditorName      String
  opinionStatus    String   @default("WTP") // Wajar Tanpa Pengecualian
  totalFundsIn     Float
  totalFundsOut    Float
  beneficiaryCount Int
  operationalRatio String?
  summary          String?
  pdfUrl           String?
  publishedAt      DateTime @default(now())

  @@index([year])
}

model Volunteer {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String
  city       String
  interest   String
  motivation String
  status     String   @default("PENDING") // PENDING, APPROVED, CONTACTED
  createdAt  DateTime @default(now())

  @@index([status])
}

model Article {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  tags           String[] @default([])
  excerpt        String
  content        String
  author         String
  bannerUrl      String?
  imageSource    String?
  imageSourceUrl String?
  likeCount      Int      @default(0)
  dislikeCount   Int      @default(0)
  publishedAt    DateTime @default(now())

  @@index([category])
}
